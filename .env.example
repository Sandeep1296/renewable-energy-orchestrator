# GEMINI_API_KEY: Required for Gemini AI API calls (LangChain supervisor + sub-agents).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLERK — email login + org Roles & Permissions (Admin / Member).
# Dashboard setup (dashboard.clerk.com):
#  1. Create application → Authentication → enable Email address.
#     Use "Email verification code" for passwordless email login.
#  2. Organization settings → enable Organizations, then Roles & Permissions:
#     keep defaults org:admin (Admin) and org:member (Member).
#  3. Create an Organization → invite operators → assign Admin / Member.
#  4. API Keys → copy Publishable Key (frontend) and Secret Key (backend).
# Role enforcement in this app (deny-by-default; unknown roles are read-only):
#   org:admin              → skills/RAG/DAG edits + HITL approve
#   org:operator (custom)  → HITL approve, no config edits
#   org:member             → HITL approve
#   org:viewer (custom)    → read-only dashboards
# Custom JWT permissions also grant: org:config:edit, org:dispatch:approve, org:dispatch:run
# (create them under Roles & Permissions → Features; system permissions are NOT in tokens).
# After changing a member's role, they must refresh their session (sign out/in or
# switch orgs) before the new org_role claim takes effect.
# Without these keys the app runs as local-operator with full access (demo mode).
# VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# LLM providers (chain with free-tier failover). At least one key required for live reasoning;
# without keys the engine runs the grounded deterministic fallback.
# GEMINI_API_KEY is already set above.
# GROQ_API_KEY: get one at https://console.groq.com/keys (generous free tier)
# GROQ_API_KEY=""
# GROQ_MODEL_CHAIN="openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3.8-27b"
#   Ordered reasoning fallback (prompt-guard classifiers excluded — they vote via
#   the DAG-08S safety screen instead, in native single-message format).
# GROQ_GUARD_MODEL="meta-llama/llama-prompt-guard-2-22m"  # safety-screen classifier
#
# NEO4J_URI="" / NEO4J_USER="" / NEO4J_PASSWORD="" — optional AuraDB topology
# mirror for outage tracing. Unset = in-memory graph analysis (fully working).
# GRAPH_MIRROR="auto" — auto = sync on impact calls when configured; off = never sync.
#
# LIVE_WEATHER="true"  # real Open-Meteo wind/cloud/temp per site (no key); false = simulated only
#
# Free-tier tuning (defaults are conservative):
# LLM_CHAIN_ORDER="gemini,groq"   # provider attempt order; first success wins
# SUBAGENT_MODE="batch"           # batch = 1 call for all 5 votes; parallel = 5 sequential calls
# SUBAGENT_CACHE_TTL_MS="45000"   # identical grid states reuse handoff, no re-spend
# LLM_CALL_SPACING_MS="15000"     # gap under rate pressure (15s default; 30000 if TPM limits still hit). Healthy providers use a 2s gap.
# MAX_LLM_CALLS_PER_MIN="8"       # per-minute call budget guard
# LLM_CACHE_TTL_MS="60000"        # identical prompts served from cache
# LLM_CIRCUIT_THRESHOLD="3"       # consecutive fails before a provider is skipped
# LLM_CIRCUIT_COOLDOWN_MS="300000" # skip duration (5m); daily-quota 429s fail over with no retry sleep
